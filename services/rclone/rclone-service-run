#!/data/data/com.termux/files/usr/bin/sh
exec 2>&1
export HOME='/data/data/com.termux/files/home'
export PREFIX='/data/data/com.termux/files/usr'
export PATH='/data/data/com.termux/files/usr/bin'
export TMPDIR='/data/data/com.termux/files/usr/tmp'

# Local automation uses loopback RC. Remote access must pass the authenticated
# Caddy proxy (5573), with IPv4 5572 redirected by router-security.sh.
exec '/data/data/com.termux/files/usr/bin/rclone' rcd \
    --config='/data/data/com.termux/files/home/router-data/rclone/rclone.conf' \
    --disable copy \
    --buffer-size 16M \
    --rc-addr='127.0.0.1:5572' \
    --rc-files="$HOME/.cache/rclone/webgui/current/build" \
    --rc-serve \
    --rc-no-auth
