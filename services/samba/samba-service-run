#!/data/data/com.termux/files/usr/bin/sh
set -u
exec 2>&1
export HOME=/data/data/com.termux/files/home PREFIX=/data/data/com.termux/files/usr
export PATH="$PREFIX/bin:/system/bin" TMPDIR="$PREFIX/tmp"
ROOT_RUN=/data/adb/router-samba/samba-root.sh
SU_PID=''
shutdown() {
    trap - INT TERM HUP EXIT
    "$PREFIX/bin/su" -c "/system/bin/sh $ROOT_RUN stop" || true
    [ -z "$SU_PID" ] || kill "$SU_PID" 2>/dev/null || true
    exit 0
}
trap shutdown INT TERM HUP EXIT
"$PREFIX/bin/su" -c "exec /system/bin/sh $ROOT_RUN run" &
SU_PID=$!
wait "$SU_PID"
shutdown
